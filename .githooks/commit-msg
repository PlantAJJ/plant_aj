#!/usr/bin/env bash
# commit-msg hook — enforces Conventional Commits specification
# https://www.conventionalcommits.org/
#
# Install: cp commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# ── colours ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

# ── allowed types ──────────────────────────────────────────────────────────────
TYPES="feat|fix|docs|style|refactor|perf|test|chore|build|ci|revert"

# ── pattern ────────────────────────────────────────────────────────────────────
# Matches:
#   feat: add login page
#   fix(auth): handle null token
#   feat!: drop Node 14 support          ← breaking change shorthand
#   chore(deps)!: bump major versions
PATTERN="^($TYPES)(\([a-zA-Z0-9_/-]+\))?(!)?: .{1,100}$"

# Strip comment lines (lines starting with #) before validating
STRIPPED=$(grep -v '^#' "$COMMIT_MSG_FILE" | head -n 1)

# ── validate ───────────────────────────────────────────────────────────────────
if echo "$STRIPPED" | grep -qE "$PATTERN"; then
  echo -e "${GREEN}✔ Commit message follows Conventional Commits.${RESET}"
  exit 0
fi

# ── rejection message ──────────────────────────────────────────────────────────
echo -e "${RED}✖ Invalid commit message format.${RESET}"
echo ""
echo -e "${YELLOW}Your message:${RESET}"
echo -e "  ${CYAN}${STRIPPED}${RESET}"
echo ""
echo -e "${YELLOW}Expected format:${RESET}"
echo -e "  ${CYAN}<type>[optional scope][optional !]: <description>${RESET}"
echo ""
echo -e "${YELLOW}Allowed types:${RESET}"
echo -e "  ${CYAN}feat${RESET}      · A new feature"
echo -e "  ${CYAN}fix${RESET}       · A bug fix"
echo -e "  ${CYAN}docs${RESET}      · Documentation changes only"
echo -e "  ${CYAN}style${RESET}     · Formatting, whitespace (no logic change)"
echo -e "  ${CYAN}refactor${RESET}  · Code change that is neither a fix nor a feature"
echo -e "  ${CYAN}perf${RESET}      · Performance improvement"
echo -e "  ${CYAN}test${RESET}      · Adding or fixing tests"
echo -e "  ${CYAN}chore${RESET}     · Build process or tooling changes"
echo -e "  ${CYAN}build${RESET}     · Changes to build system or dependencies"
echo -e "  ${CYAN}ci${RESET}        · CI/CD configuration changes"
echo -e "  ${CYAN}revert${RESET}    · Reverts a previous commit"
echo ""
echo -e "${YELLOW}Examples:${RESET}"
echo -e "  ${GREEN}feat: add user authentication${RESET}"
echo -e "  ${GREEN}fix(api): handle empty response body${RESET}"
echo -e "  ${GREEN}chore(deps)!: upgrade to webpack 6${RESET}  ${CYAN}← breaking change${RESET}"
echo ""
exit 1
