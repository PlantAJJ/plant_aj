# ==============================================================================
# BACKEND - PYTHON
# ==============================================================================

# Current application environment (development / production)
ENVIRONMENT=development
API_PORT=8000

# Secret key used for cryptographic signing (e.g., JWT tokens, sessions)
# Dev tip: Generate a secure string using `openssl rand -hex 32` in your terminal
SECRET_KEY=your_super_secret_key_change_me_in_dev

# Database Configuration (PostgreSQL / MySQL / SQLite)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_name
DB_USER=db_user
DB_PASSWORD=your_secure_password_here

# CORS Configuration (Allowed origins that can fetch data from this backend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# FRONTEND - REACT (Vite)
# ==============================================================================

# Base URL for your Python REST API backend.
VITE_API_URL=http://localhost:8000/api/v1